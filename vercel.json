{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "comment": "CSS and JS share a stable filename, so they must never be immutable: a cached copy would keep pairing old styles with new markup until it expired. Revalidate on every load instead; a 304 is cheap.",
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "comment": "Media is content-addressed by name in practice: a different cut gets a different filename, so it is safe to cache hard.",
      "source": "/assets/(video|img|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/video/(.*).m3u8",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.apple.mpegurl" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/video/(.*).ts",
      "headers": [
        { "key": "Content-Type", "value": "video/mp2t" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
